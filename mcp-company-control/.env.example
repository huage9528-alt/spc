# 中台（SPC）只读查询端点
CONTROL_PLATFORM_BASE_URL=http://127.0.0.1:8000/api/v1

# 认证（优先级 1）：数据供给 HMAC API Key —— 生产推荐
# 创建位置：SPC → 基础数据中心 → 数据供给 → 新建 API Key（AppSecret 仅显示一次）
# 需勾选接口：int:health.ping、orders.list、order_details.list、boms.tree
CONTROL_PLATFORM_APP_KEY=
CONTROL_PLATFORM_APP_SECRET=

# 认证（优先级 2）：静态 Bearer Token
CONTROL_PLATFORM_TOKEN=

# 认证（优先级 3）：OAuth2 client_credentials
CONTROL_PLATFORM_CLIENT_ID=
CONTROL_PLATFORM_CLIENT_SECRET=
# 可选：自定义令牌端点（默认 {BASE_URL}/oauth/token）
CONTROL_PLATFORM_TOKEN_URL=

# 超时（毫秒）
CONTROL_PLATFORM_TIMEOUT_MS=15000
CONTROL_PLATFORM_CONNECT_TIMEOUT_MS=5000

# ---- MCP 传输模式（CLI 参数优先：--transport / --host / --port）----
# stdio（默认，AEOS Hub 拉起）| streamable-http（远程客户端）
MCP_TRANSPORT=stdio

# HTTP 模式监听地址与端口
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8902

# HTTP 模式静态 Bearer Token（必填；为空则拒绝启动 HTTP 模式）
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_HTTP_TOKEN=

# 可选：资源元数据 URL（OAuth PRM 发现用；默认 http://127.0.0.1:{MCP_HTTP_PORT}）
MCP_HTTP_PUBLIC_URL=
